--!strict
-- The hexagonal upgrade tree. Tiles sit on axial hex coordinates (q, r) with
-- the free Farm Heart at (0, 0). A tile is available when any neighbouring
-- tile is owned, its `requires` tile (if any) is owned, and its milestone is
-- met. Keystones are permanent: they survive rebirth.
--
-- Effects modify the stat block computed by Logic/Stats:
--   add: stat += value * level
--   mul: stat *= value ^ level
--   set: stat = value (when owned; for flags and caps)
-- Cost of buying level L (1-based) = baseCost * growth ^ (L - 1).

export type EffectMode = "add" | "mul" | "set"

export type Effect = {
	stat: string,
	mode: EffectMode,
	value: number,
}

export type Milestone = {
	rebirths: number?,
	speciesFound: number?,
}

export type Tile = {
	id: string,
	name: string,
	category: string, -- Core | Income | Luck | Rolling | Hatching | Farm | Economy
	q: number,
	r: number,
	maxLevel: number,
	baseCost: number,
	growth: number,
	requires: string?,
	milestone: Milestone?,
	keystone: boolean?,
	effects: { Effect },
	description: string,
}

local function add(stat: string, value: number): Effect
	return { stat = stat, mode = "add", value = value }
end
local function mul(stat: string, value: number): Effect
	return { stat = stat, mode = "mul", value = value }
end
local function set(stat: string, value: number): Effect
	return { stat = stat, mode = "set", value = value }
end

