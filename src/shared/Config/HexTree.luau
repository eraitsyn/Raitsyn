local byId: { [string]: Tile } = {}
local byCoord: { [string]: Tile } = {}
for _, tile in tiles do
	assert(byId[tile.id] == nil, `duplicate tile id {tile.id}`)
	byId[tile.id] = tile
	local key = `{tile.q},{tile.r}`
	assert(byCoord[key] == nil, `two tiles at {key}`)
	byCoord[key] = tile
end

return table.freeze({
	coreId = "FarmHeart",
	tiles = table.freeze(tiles),
	byId = table.freeze(byId),
	byCoord = table.freeze(byCoord),
})
