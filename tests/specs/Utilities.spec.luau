local Test = require("../lib/Test")
local Game = require("../lib/Game")
local describe, it, expect = Test.describe, Test.it, Test.expect

local Income = Game.get("ReplicatedStorage.Shared.Logic.Income")
local Rules = Game.get("ReplicatedStorage.Shared.Logic.Rules")
local Format = Game.get("ReplicatedStorage.Shared.Logic.Format")
local Validate = Game.get("ReplicatedStorage.Shared.Logic.Validate")
local RollTiers = Game.get("ReplicatedStorage.Shared.Config.RollTiers")

describe("Income", function()
	it("multiplies rarity, species and variant", function()
		expect(Income.petBase("BarnChick", "Normal")).toBeNear(0.9, 1e-12)
		expect(Income.petBase("PondDuckling", "Shiny")).toBeNear(1 * 1.3 * 2.5, 1e-12)
		expect(Income.petBase("HarvestWyrm", "Rainbow")).toBeNear(5000 * 1.3 * 6, 1e-9)
		expect(Income.petBase("Unknown", "Normal")).toBe(0)
		expect(Income.petBase("BarnChick", "Bogus")).toBeNear(0.9, 1e-12)
	end)

	it("sums the farm and applies the multiplier once", function()
		local placed = {
			{ species = "CloverBunny", variant = "Normal" },
			{ species = "MossGoat", variant = "Normal" },
		}
		expect(Income.farmRate(placed, 2)).toBeNear((1 + 3) * 2, 1e-12)
		expect(Income.farmRate({}, 5)).toBe(0)
	end)

	it("pays crits only below the crit chance", function()
		local amount, crit = Income.tick(10, 0.1, 3, 0.05)
		expect(amount).toBe(30)
		expect(crit).toBe(true)
		amount, crit = Income.tick(10, 0.1, 3, 0.5)
		expect(amount).toBe(10)
		expect(crit).toBe(false)
		expect(Income.expectedRate(10, 0.1, 3)).toBeNear(12, 1e-12)
	end)
end)

describe("Rules", function()
	it("unlocks roll tiers by lifetime coins and rebirths", function()
		expect(Rules.tierUnlocked("Basic", 0, 0)).toBe(true)
		expect(Rules.tierUnlocked("Silver", 49_999, 0)).toBe(false)
		expect(Rules.tierUnlocked("Silver", 50_000, 0)).toBe(true)
		expect(Rules.tierUnlocked("Cosmic", RollTiers.byId.Cosmic.unlockLifetimeCoins, 0)).toBe(false)
		expect(Rules.tierUnlocked("Cosmic", RollTiers.byId.Cosmic.unlockLifetimeCoins, 1)).toBe(true)
		expect(Rules.tierUnlocked("Nope", 1e30, 99)).toBe(false)
	end)

	it("runs the daily streak", function()
		local h = 3600
		local first = Rules.daily(0, 0, 1000)
		expect(first.canClaim).toBe(true)
		expect(first.nextDay).toBe(1)
		local tooSoon = Rules.daily(1, 1000, 1000 + 19 * h)
		expect(tooSoon.canClaim).toBe(false)
		expect(tooSoon.secondsUntilClaim).toBe(h)
		local next = Rules.daily(1, 1000, 1000 + 21 * h)
		expect(next.canClaim).toBe(true)
		expect(next.nextDay).toBe(2)
		local wraps = Rules.daily(7, 1000, 1000 + 21 * h)
		expect(wraps.nextDay).toBe(1)
		local missed = Rules.daily(5, 1000, 1000 + 49 * h)
		expect(missed.canClaim).toBe(true)
		expect(missed.nextDay).toBe(1)
		local future = Rules.daily(3, 5000, 1000)
		expect(future.canClaim).toBe(false)
	end)

	it("scales daily coins with income and keeps a floor", function()
		expect(Rules.dailyCoins(1, 0)).toBe(500)
		expect(Rules.dailyCoins(1, 100)).toBe(30_000)
		expect(Rules.dailyCoins(3, 100)).toBe(0) -- egg-only day
	end)

	it("clamps offline earnings to the cap and ignores clock rollback", function()
		local payout, seconds = Rules.offlineEarnings(100, 0.25, 2, 1000, 1000 + 3600)
		expect(seconds).toBe(3600)
		expect(payout).toBe(90_000)
		payout, seconds = Rules.offlineEarnings(100, 0.25, 2, 1000, 1000 + 999_999)
		expect(seconds).toBe(7200)
		payout = Rules.offlineEarnings(100, 0.25, 2, 5000, 1000)
		expect(payout).toBe(0)
		payout = Rules.offlineEarnings(100, 0, 2, 1000, 9000)
		expect(payout).toBe(0)
	end)
end)

describe("Format", function()
	it("abbreviates numbers to three significant digits without overflowing a suffix", function()
		expect(Format.number(0)).toBe("0")
		expect(Format.number(999)).toBe("999")
		expect(Format.number(1000)).toBe("1K")
		expect(Format.number(1234)).toBe("1.23K")
		expect(Format.number(45_600_000)).toBe("45.6M")
		expect(Format.number(999_999)).toBe("999K")
		expect(Format.number(1.5e12)).toBe("1.5T")
		expect(Format.number(20_000)).toBe("20K")
		expect(Format.number(-2500)).toBe("-2.5K")
		expect(Format.number(0 / 0)).toBe("0")
	end)

	it("formats coins, rates, percents, durations and commas", function()
		expect(Format.coins(1500)).toBe("$1.5K")
		expect(Format.rate(12)).toBe("$12/s")
		expect(Format.percent(0.55)).toBe("55%")
		expect(Format.percent(0.04)).toBe("4%")
		expect(Format.percent(0.009)).toBe("0.9%")
		expect(Format.percent(0.00001)).toBe("0.001%")
		expect(Format.duration(4.25)).toBe("4.2s")
		expect(Format.duration(95)).toBe("1m 35s")
		expect(Format.duration(3725)).toBe("1h 2m")
		expect(Format.commas(100000)).toBe("100,000")
		expect(Format.commas(1010)).toBe("1,010")
		expect(Format.commas(999)).toBe("999")
	end)
end)

describe("Validate", function()
	it("accepts only clean ids", function()
		expect(Validate.id("PetIncome1")).toBe(true)
		expect(Validate.id("")).toBe(false)
		expect(Validate.id("a b")).toBe(false)
		expect(Validate.id(string.rep("a", 65))).toBe(false)
		expect(Validate.id(5)).toBe(false)
	end)

	it("accepts only finite integers in range", function()
		expect(Validate.integer(3, 1, 24)).toBe(true)
		expect(Validate.integer(0, 1, 24)).toBe(false)
		expect(Validate.integer(2.5, 1, 24)).toBe(false)
		expect(Validate.integer(0 / 0, 1, 24)).toBe(false)
		expect(Validate.integer(math.huge, 1, math.huge)).toBe(false)
		expect(Validate.integer("3", 1, 24)).toBe(false)
	end)

	it("accepts only short arrays of unique ids", function()
		expect(Validate.idList({ "a", "b" }, 5)).toBe(true)
		expect(Validate.idList({ "a", "a" }, 5)).toBe(false)
		expect(Validate.idList({}, 5)).toBe(false)
		expect(Validate.idList({ "a", "b", "c" }, 2)).toBe(false)
		expect(Validate.idList({ x = "a" }, 5)).toBe(false)
		expect(Validate.idList({ "a", 5 }, 5)).toBe(false)
	end)

	it("checks membership in a config lookup", function()
		expect(Validate.oneOf("Basic", RollTiers.byId)).toBe(true)
		expect(Validate.oneOf("Ultra", RollTiers.byId)).toBe(false)
		expect(Validate.oneOf(nil, RollTiers.byId)).toBe(false)
	end)
end)

return nil
